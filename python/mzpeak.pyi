from typing import Any, Iterator
import numpy as np
from numpy.typing import NDArray

__version__: str
FORMAT_VERSION: str

def convert(input: str, output: str, *, compression_level: int = 3, batch_size: int = 256, rawr_binary: str | None = None) -> dict[str, Any]: ...
def validate(path: str) -> dict[str, int]: ...

class Spectrum:
    metadata: dict[str, Any]
    mz: NDArray[np.float64]
    intensity: NDArray[np.float32]
    ion_mobility: NDArray[np.float64] | None
    def __len__(self) -> int: ...

class Reader:
    def __init__(self, path: str, *, batch_size: int = 65536) -> None: ...
    def metadata(self) -> dict[str, Any]: ...
    def manifest(self) -> dict[str, Any]: ...
    def __iter__(self) -> Iterator[Spectrum]: ...

class Writer:
    def __init__(self, path: str, *, ion_mobility: bool = False, imaging: bool = False, compression_level: int = 3) -> None: ...
    def write(self, metadata: dict[str, Any], mz: NDArray[np.float64], intensity: NDArray[np.float32], ion_mobility: NDArray[np.float64] | None = None) -> None: ...
    def set_metadata(self, metadata: dict[str, Any]) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Writer: ...
    def __exit__(self, exception_type: Any, exception: Any, traceback: Any) -> None: ...
